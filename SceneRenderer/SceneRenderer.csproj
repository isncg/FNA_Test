<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../FNA/FNA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Common/ImGuiBindings.cs" />
    <Compile Include="../Common/ImGuiTestHarness.cs" />
    <Compile Include="../Common/TestHarness.cs" />
    <Compile Include="../Common/GeometryGen.cs" />
    <Compile Include="../Common/GlutTeapot.cs" />
    <Compile Include="../Common/TextureGen.cs" />
  </ItemGroup>

  <!-- Embed FEB shader binaries -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders/GBuffer.feb" />
    <EmbeddedResource Include="Shaders/DeferredLighting.feb" />
    <EmbeddedResource Include="Shaders/SSAO.feb" />
    <EmbeddedResource Include="Shaders/BlurAO.feb" />
    <EmbeddedResource Include="Shaders/SSR.feb" />
    <EmbeddedResource Include="Shaders/ShadowMap.feb" />
    <EmbeddedResource Include="Shaders/Skybox.feb" />
    <EmbeddedResource Include="Shaders/Bloom.feb" />
    <EmbeddedResource Include="Shaders/Tonemap.feb" />
    <EmbeddedResource Include="Shaders/DebugView.feb" />
    <EmbeddedResource Include="Shaders/IrradianceConv.feb" />
    <EmbeddedResource Include="Shaders/BrdfLut.feb" />
    <EmbeddedResource Include="Shaders/PrefilterEnv.feb" />
  </ItemGroup>

  <!-- Copy material assets to output -->
  <ItemGroup>
    <Content Include="../assets/materials/**/*.jpg" CopyToOutputDirectory="PreserveNewest" LinkBase="assets/materials/" />
    <Content Include="../assets/materials/**/*.hdr" CopyToOutputDirectory="PreserveNewest" LinkBase="assets/materials/" />
  </ItemGroup>
</Project>
